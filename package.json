{
  "name": "track-oot",
  "description": "Tracker for OOT-Randomizer",
  "author": "Denis Weiß (ZidArgs)",
  "license": "MIT",
  "homepage": "https://github.com/GameStateTracker/Track-OOT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/GameStateTracker/Track-OOT.git"
  },
  "bugs": {
    "url": "https://github.com/GameStateTracker/Track-OOT/issues"
  },
  "type": "module",
  "dependencies": {
    "@emcjs/core": "https://github.com/ZidArgs/emcJS-Core.git/#1.4.1",
    "@emcjs/logic": "https://github.com/ZidArgs/emcJS-Logic.git/#0.3.0",
    "@emcjs/fe": "https://github.com/ZidArgs/emcJS-FE.git/#0.2.0",
    "archipelagojs": "https://github.com/ZidArgs/ArchipelagoJS.git/#1.2.0",
    "gametrackerjs": "https://github.com/GameStateTracker/GameTrackerJS.git/#0.12.1",
    "jseditors": "https://github.com/ZidArgs/JSEditors.git/#0.5.0",
    "jswebservice": "https://github.com/ZidArgs/JSWebservice.git/#3.2.1",
    "rtcclient": "https://github.com/ZidArgs/RTCClient.git/#1.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/eslint-parser": "^7.28.4",
    "@babel/plugin-syntax-import-assertions": "^7.27.1",
    "@babel/plugin-syntax-top-level-await": "^7.14.5",
    "@stylistic/eslint-plugin": "^5.4.0",
    "@zidargs/buildtools": "https://github.com/ZidArgs/BuildTools.git/#1.2.1",
    "electron": "^28.1.0",
    "eslint": "^9.36.0",
    "gulp": "^4.0.2",
    "gulp-autoprefixer": "^7.0.1",
    "gulp-changed": "^5.0.4",
    "gulp-htmlmin": "^5.0.1",
    "gulp-jsonminify": "^1.1.0",
    "gulp-svgo": "^2.1.0"
  },
  "exports": {
    "./*": "./src/*"
  },
  "scripts": {
    "lint": "yarn eslint .",
    "lintfix": "yarn eslint --fix .",
    "integrityCheck": "node ./test/verifyWorldFile.js",
    "build": "gulp build",
    "buildDev": "gulp buildDev -nocompress",
    "watch": "gulp watch -nocompress",
    "serve": "node --trace-deprecation ./server.js",
    "correctWorld": "node ./correctWorldData.js",
    "buildEditor": "gulp --gulpfile ./editor/gulpfile.js build -rebuild -nocompress -nodelete",
    "edit": "gulp --gulpfile ./editor/gulpfile.js build -rebuild -nocompress && electron ./editor --no-sandbox > ./editor/info.log 2>&1 -debug",
    "editWeb": "node ./editor/server.js"
  }
}
